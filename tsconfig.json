{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./"
  },
  "include": ["src/**/*", "server/**/*", "scripts/**/*"],
  "exclude": ["supabase/**/*", "node_modules", "dist"],
  "ts-node": {
    "files": true
  }
}
